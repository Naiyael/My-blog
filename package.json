{
  "name": "naiyael-personal-space",
  "version": "3.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:theme": "vitepress dev docs --host 127.0.0.1 --port 4174",
    "build": "vitepress build docs",
    "preview": "vitepress build docs && wrangler d1 migrations apply DB --local && wrangler dev",
    "deploy": "vitepress build docs && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "test": "node --test tests/*.test.mjs",
    "sync": "node scripts/sync-platforms.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "markdown-it": "^14.1.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "vitepress": "^1.6.4",
    "vitepress-theme-teek": "^1.6.2",
    "wrangler": "^4.168.0"
  }
}
