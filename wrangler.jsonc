{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "naiyael-blog",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "naiyael-blog-db",
      "migrations_dir": "drizzle"
    }
  ]
  // 如后续在 Cloudflare 开通 R2，取消下方注释并在 CF 创建同名存储桶即可自动启用后台图片上传：
  // "r2_buckets": [
  //   {
  //     "binding": "BUCKET",
  //     "bucket_name": "naiyael-blog-media"
  //   }
  // ]
}
